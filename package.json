{
  "name": "llm-router",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent LLM routing based on cost, latency, and quality",
  "type": "module",
  "scripts": {
    "build": "pnpm install && turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "keywords": [
    "llm",
    "routing",
    "cost-optimization",
    "multi-model",
    "mcp",
    "agent",
    "fallback",
    "telemetry",
    "eval"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild", "protobufjs"]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/llm-router.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/llm-router/issues"
  },
  "homepage": "https://github.com/reaatech/llm-router#readme",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.28.1",
    "@vitest/coverage-v8": "3.2.4",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
