{
  "name": "@reaatech/llm-router-telemetry",
  "version": "1.0.0",
  "description": "Cost tracking, budget management, and OTel metrics for llm-router",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/llm-router.git",
    "directory": "packages/telemetry"
  },
  "homepage": "https://github.com/reaatech/llm-router/tree/main/packages/telemetry#readme",
  "bugs": {
    "url": "https://github.com/reaatech/llm-router/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@reaatech/llm-router-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
